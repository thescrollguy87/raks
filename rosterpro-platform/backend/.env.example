# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ── Database (matches docker-compose.yml's postgres service) ───────────────
DATABASE_URL=postgresql://rosterpro:rosterpro_dev_password@localhost:5432/rosterpro

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (use TWO DIFFERENT values)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Passwords ───────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── MFA ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=replace-with-a-long-random-string

# ── Email (verification, password reset, daily shift reminders) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="RosterPro <your-email@gmail.com>"

# ── WhatsApp (shift-change alerts) — via Twilio ─────────────────────────────
# Sign up at twilio.com. For testing, use the free WhatsApp Sandbox
# (Console → Messaging → Try WhatsApp) — each recipient must first send the
# sandbox's join code to your Twilio number once. For production, apply for
# a WhatsApp Business Sender under the same account (needs Meta business
# verification, typically a few days).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Notification scheduler ──────────────────────────────────────────────────
# Cron expression for the daily "tomorrow's shift" reminder. Default: 18:00.
# Compliance/tool/quality overdue checks run daily at 06:00 (not separately
# configurable yet — edit src/jobs/scheduledJobs.js if you need to change that).
DAILY_REMINDER_CRON=0 18 * * *
TZ=Asia/Kolkata
