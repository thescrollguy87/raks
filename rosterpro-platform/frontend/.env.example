# Backend URL the Vite dev server proxies /api requests to.
# In production, the frontend is typically served from the same domain/CDN
# in front of the API (see the AWS deployment guide in Module 7), so this
# only matters for local development.
VITE_API_PROXY_TARGET=http://localhost:4000

# TODO(Module 6 Pass 2): temporary single-station default. Once a station
# switcher exists, this becomes the fallback for users whose account is
# scoped to exactly one station, not a hardcoded value read by every page.
# Get this UUID from your seeded Station row (see backend README).
VITE_DEFAULT_STATION_ID=replace-with-your-station-uuid
