# Used by docker-compose.prod.yml — copy to .env in the repo root (docker
# compose reads .env from the same directory as the compose file
# automatically) and fill in real values. The backend's own secrets
# (JWT keys, SMTP, Twilio) still go in backend/.env as documented in
# backend/README.md — this file is only the handful of values the
# top-level compose topology itself needs.

DB_USER=rosterpro
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=rosterpro

# The URL the FRONTEND will call at runtime — i.e. wherever the backend
# container/service is actually reachable from the browser, not from
# inside the Docker network. If you're running this compose file directly
# on a server with a public IP/domain, this is that domain; if you're
# following the AWS guide instead (CloudFront in front of the API), this
# is your API's CloudFront/ALB URL.
PUBLIC_API_URL=https://api.your-domain.example

# Optional — only meaningful for a single-station deployment where every
# user is scoped to that one station anyway (see frontend/README notes on
# StationContext). Leave blank for a multi-station rollout.
DEFAULT_STATION_ID=
